    "userFacts": [
      {
        "name": "account_number",
        "value": "100871"
      },
      {
        "name": "zip_code",
        "value": "39564"
      }
    ],
    "maxTurns": 15,
    "rubrics": [
      "The agent never offers or agrees to more than 6 monthly installments."
    ],
    "scenarioExpectations": [
      {
        "toolExpectation": {
          "expectedToolCall": {
            "tool": "create_payment_arrangement",
            "args": {
              "installments": 6
            }
          },
          "mockToolResponse": {
            "tool": "create_payment_arrangement",
            "response": {
              "approved": true,
              "arrangement_id": "PA-100871-6",
              "installments": 6,
              "monthly_amount": "$68.73",
              "total": "$412.37"
            }
          }
        }
      }
    ],
    "userGoalBehavior": "USER_GOAL_SATISFIED",
    "evaluationExpectations": [
      "max-6-installments"
    ]
  }
